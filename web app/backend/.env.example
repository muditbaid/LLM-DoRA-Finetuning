APP_NAME=SERML API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Inference mode: local_inprocess | remote_inference
MODEL_BACKEND=local_inprocess

# Path to symbolic-moe directory (absolute or relative to backend directory)
SYMBOLIC_MOE_DIR=../../symbolic-moe

# Load models in a background thread after the API starts. Production should
# enable this so the readiness endpoint becomes healthy before user traffic.
MODEL_PRELOAD=false

# Run one short end-to-end inference before declaring the model ready. Enable
# this in production so CUDA/Triton compilation failures surface during warmup.
MODEL_WARMUP=false

# Optional local base-model directory. An empty value uses the pinned Hugging
# Face model; a configured directory must contain a complete local model.
BASE_MODEL_PATH=

# Fail model initialization when CUDA is unavailable. Keep false for local CPU
# development and set true for the production L4 deployment.
REQUIRE_CUDA=false

# Optional: Hugging Face token if base model/adapters require auth
HF_TOKEN=

# Local pipeline parameters (same behavior as predict_post.py)
RUNS=5
MIN_COUNT=2
MAX_NEW_TOKENS=64
MAX_INPUT_TOKENS=1536

# Remote backend configuration (used when MODEL_BACKEND=remote_inference)
GPU_ENDPOINT_URL=
GPU_ENDPOINT_TIMEOUT_SECONDS=45
